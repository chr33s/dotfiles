#!/usr/bin/env bash

# `man -t` emits PostScript, which Preview no longer renders, so convert to PDF.
manp() {
  if [ -z "$1" ]; then
    echo "usage: manp <page>" >&2
    return 1
  fi

  local dir pdf
  dir="$(mktemp -d)" || return 1
  pdf="${dir}/${1##*/}.pdf"

  if command -v ps2pdf >/dev/null 2>&1; then
    man -t "$1" | ps2pdf - "$pdf" && open -a Preview "$pdf" && return 0
  fi

  if command -v mandoc >/dev/null 2>&1; then
    local src
    src="$(man -w "$1" 2>/dev/null | head -n 1)"
    if [ -n "$src" ]; then
      case "$src" in
        *.gz) gunzip -c "$src" ;;
        *) cat "$src" ;;
      esac | mandoc -T pdf >"$pdf" && open -a Preview "$pdf" && return 0
    fi
  fi

  echo "manp: no PostScript/PDF converter found (install ghostscript or mandoc)," >&2
  echo "      falling back to the terminal pager." >&2
  man "$1"
}

manp "$@"
