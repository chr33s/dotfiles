#!/usr/bin/env bash

# Rewrite the author/committer identity on every commit of every ref.
#
# NOTE: `git filter-repo` (https://github.com/newren/git-filter-repo) is the
# modern, faster and safer replacement for `git filter-branch`; prefer it if
# it is installed:
#   git filter-repo --mailmap <mailmap-file>
rename() { # <name> <email>
  if [ -z "$1" ] || [ -z "$2" ]; then
    echo "usage: rename <name> <email>" >&2
    return 1
  fi

  echo "WARNING: this REWRITES HISTORY for all refs (--all)." >&2
  echo "         Every commit hash will change and any published branch will" >&2
  echo "         need a force push. Make a backup first." >&2

  # The values are interpolated into exported variables BEFORE git runs, so the
  # single-quoted filter body never has to reference this function's $1/$2
  # (inside filter-branch those are git's own arguments).
  NEW_NAME="$1" NEW_EMAIL="$2" \
    git filter-branch -f --env-filter '
      export GIT_AUTHOR_NAME="$NEW_NAME"
      export GIT_AUTHOR_EMAIL="$NEW_EMAIL"
      export GIT_COMMITTER_NAME="$NEW_NAME"
      export GIT_COMMITTER_EMAIL="$NEW_EMAIL"
    ' --tag-name-filter cat -- --all
}

"$@"
