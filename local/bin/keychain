#!/usr/bin/env sh

function keychain() {
  if [ -z "$2" ]; then
    echo "Error: No token name provided."
    return 1
  fi
  
  function add() {
    security add-generic-password -a "${USER}" -s "$1" -w
    if [ $? -ne 0 ]; then
      echo "Error: Failed to add token to keychain."
      return 1
    fi
  }

  function find() {
    security find-generic-password -a ${USER} -s "$1" -w
  }

  ${@}
}

${@}